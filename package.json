{
  "name": "@doebling/parce-admin-ui",
  "version": "0.1.0",
  "description": "A dense admin UI kit for SvelteKit and Tailwind CSS 4 — dark by default, with light and seasonal themes.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doebling/parce-admin-ui.git"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "tailwindcss",
    "admin",
    "dashboard",
    "ui",
    "components"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run package",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write ."
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./compat.css": "./dist/compat.css"
  },
  "peerDependencies": {
    "lucide-svelte": ">=0.500.0 <2",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "lucide-svelte": "^1.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
